# 공공데이터포털 > 마이페이지 > 데이터 활용 > 개발계정 상세에서 "일반 인증키" 복사
G2B_SERVICE_KEY=

# 텔레그램 @BotFather 로 봇을 만들면 받는 토큰
TELEGRAM_BOT_TOKEN=
# 알림을 받을 대화방 ID
TELEGRAM_CHAT_ID=

# Neon 연결 문자열. 비워두면 .data/ 폴더의 JSON 파일에 저장한다.
DATABASE_URL=

# 배포본에서만 설정한다. /api/notify 를 크론만 부를 수 있게 막는다.
# 로컬에 넣으면 설정 화면의 "지금 한 번 실행" 버튼이 막힌다.
CRON_SECRET=

# 배포본에서만 설정한다. 텔레그램 전송·규칙 저장·즐겨찾기 변경에 필요한 비밀번호.
ADMIN_PASSWORD=

# 알림 시간대·주말 판단 기준. 비우면 Asia/Seoul
ALERT_TIMEZONE=
